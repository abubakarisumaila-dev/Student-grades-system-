#include<iostream>
using namespace std;

void inputMarks(float marks[], int n) {
        cout<<"\nPlease enter the marks of all students separated with spaces: ";

        for(int i = 0; i < n; i++) {
                cin >> marks[i];

                while(marks[i] > 100 || marks[i] < 0) {
                        cout<<"Invalid entry! Please enter again out of 100. ";
                        cin >> marks[i];
                } 
        }
}


float calculateAverage(float marks[], int n) {
        float sum = 0;

        for(int i = 0; i < n; i++) {
                sum += marks[i];        
        }

        return (sum / n);
}

float findHighest(float marks[], int n) {
        float max = marks[0];

        for(int i = 1; i < n; i++) {
                if(marks[i] > max) {
                        max = marks[i];
                }
        }

        return max;
}

float findLowest(float marks[], int n) {
        float min = marks[0];

        for(int i = 1; i < n; i++) {
                if(marks[i] < min) {
                        min = marks[i];
                }
        }

        return min;
}

void countGrades(float marks[], int n, int &countA, int &countB, int &countC, int &countF) {
        for(int i = 0; i < n; i++) {
                if(marks[i] >= 90) 
                        countA += 1;
                else if(marks[i] >= 75 && marks[i] < 90)
                        countB += 1;
                else if(marks[i] >= 50 && marks[i] < 75)
                        countC += 1;
                else
                        countF += 1;        
                }        
}

void displayMarks(float marks[], int n) {
        for(int i = 0; i < n; i++) {
                cout<<"\nThe Marks of "<<i+1<<"st Student is: "<<marks[i];
        }
}

int main() {
        cout<<"-------Student Grade Management System-------";

        int countA = 0; // counters
        int countB = 0;
        int countC = 0;
        int countF = 0;

        int n; // for storing the number of students we have
        cout<<endl<<"\nHow many students do a class have, specify: ";
        cin>>n;

        float marks[n];  // array for storing marks
        inputMarks(marks, n);

        displayMarks(marks, n);

        cout<<"\nAverage Marks of Class is: "<<calculateAverage(marks, n);
        cout<<"\nHighest Marks of Class is: "<<findHighest(marks, n);
        cout<<"\nLowest Marks of Class is: "<<findLowest(marks, n);

        countGrades(marks, n, countA, countB, countC, countF);
        cout<<endl<<countA<<" students got A grade. "<<endl;
        cout<<countB<<" students got B grade. "<<endl;
        cout<<countC<<" students got C grade. "<<endl;
        cout<<countF<<" students got F grade. "<<endl;

        return 0;
}
